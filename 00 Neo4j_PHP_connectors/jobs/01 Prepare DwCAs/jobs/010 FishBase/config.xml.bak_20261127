<?xml version='1.1' encoding='UTF-8'?>
<project>
  <actions/>
  <description></description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>-1</daysToKeep>
        <numToKeep>5</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>-1</artifactNumToKeep>
        <removeLastBuild>false</removeLastBuild>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>###exit 0
cd /var/www/html/eol_php8_code/update_resources/connectors

# OK 1of4: This will add higherClassification in taxon.tab and rebuild the DwCA. With carry-over of other extensions.
# source is: fishbase.tar.gz
# generates FILENAME-with-hC.tar.gz
###php dwca_utility.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase&quot;, &quot;task&quot;: &quot;gen_hC_using_ancestry&quot;, &quot;resource_type&quot;: &quot;legacy_dwca&quot;}&apos; #using kingdom, phylum, class, order, family, genus

# OK 2of4: This use gnparser one name at a time. Not entire file.
###php run_gnparser_dwca.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase-with-hC&quot;}&apos; #OK gen neo4j_1

# OK 3of4: Start matching taxa
###php match_taxa_2DH.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase-with-hC_neo4j_1&quot;, &quot;resource_type&quot;: &quot;legacy_dwca&quot;}&apos; #OK gen +_eolID

### IMPORTANT: ONLY RUN steps 4 IF U WANT DWCA TO BECOME CSV FOR GRAPH DATABASE, IF NOT THEN SKIP THIS STEP:
# OK 4of4: Convert taxon.tab, use EOLid value for taxonID.
# REMINDER: Multiple scinames with different taxonIDs have the same canonical thus will have the same EOLid
###php use_EOLid_as_taxonID.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase-with-hC_neo4j_1_eolID&quot;, &quot;resource_type&quot;: &quot;legacy_dwca&quot;}&apos; # gen fishbase_finale

TARGET=&quot;FishBase_TraitBank_1_0.tar.gz&quot;
# step 5:
###php analyze_MoF.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase_finale&quot;}&apos;
# step 6: rename
###cd /var/www/html/eol_php8_code/applications/content_server/resources
###SOURCE=&quot;fishbase_finale_analyzed.tar.gz&quot;
###mv &quot;$SOURCE&quot; &quot;$TARGET&quot; &amp;&amp; ls -lt &quot;$TARGET&quot;
###exit 0 # the end

# OK step 5: this also converts references identifier to DOI_URL :=&gt; Taxon.tsv/Traits.tsv route
php analyze_MoF.php _ &apos;{&quot;resource_id&quot;: &quot;fishbase-with-hC_neo4j_1_eolID&quot;, &quot;datacite_search&quot;: false}&apos; #gen +&quot;_analyzed&quot; -- use this moving forward.

# Step 6 rename
cd /var/www/html/eol_php8_code/applications/content_server/resources
SOURCE=&quot;fishbase-with-hC_neo4j_1_eolID_analyzed.tar.gz&quot;
mv &quot;$SOURCE&quot; &quot;$TARGET&quot; &amp;&amp; ls -lt &quot;$TARGET&quot;

# OK step 7:
cd /var/www/html/eol_php8_code/update_resources/connectors
JSON=&apos;{&quot;task&quot;: &quot;convert_dwca_to_new_input_files&quot;, &quot;source&quot;: &quot;&apos;&quot;$TARGET&quot;&apos;&quot;}&apos;
php process_legacy_dwca.php _ &quot;$JSON&quot;
exit 0 # the end

#build other projects: [011 AmphibiaWeb text traits (15549295)]
#002_TreatmentBank_OK</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>